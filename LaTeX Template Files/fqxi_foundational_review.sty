%Abstract Environment creation

\newenvironment{Abstract}{
    \vspace*{-4\baselineskip} 
    \small
    \begin{center}
        \bfseries Abstract
    \end{center}
    \list{}{
        \leftmargin=1.5cm   % Indent the whole block from the left
        \rightmargin=1.5cm  % Indent the whole block from the right
        \listparindent=1.5em % Indent the 1st line of the block
        \parsep=0pt         % Space between internal paragraphs
    }
    \item\relax
    \hspace{\listparindent} % Forces the very first line to indent
}{
    \endlist
}

\RequirePackage{titlesec}

% Center the section titles
\titleformat{\section}
  {\Large\bfseries\centering} % Format: Font style, size, bold, and centered
  {\arabic{section}.}                          % Label: The section number (e.g., 1, 2)
  {1em}                                  % Separation: Space between number and title
  {}                                     % Code before the title

% Optional: Center subsections as well
\titleformat{\subsection}
  {\normalfont\large\itshape\centering}
  {\thesubsection}
  {1em}
  {}


% Optional: Center subsubsections as well
\titleformat{\subsubsection}
  {\normalfont\normalsize\upshape\centering}
  {\thesubsubsection}
  {1em}
  {}

\g@addto@macro{\appendix}{%
  \titleformat{\section}
    {\Large\bfseries\centering}
    {\Alph{section}.}
    {1em}
    {}%
}
% Custom Single Column bibliography formatting


\makeatletter
\renewcommand{\bibsection}{}
\makeatother


\renewcommand{\refname}{}
\renewcommand{\bibname}{}

\let\oldbibliography\bibliography

\renewcommand{\bibliography}[1]{%
  \clearpage
  \onecolumn
  

  \begin{center}
    \Large References
  \end{center}
  \vspace{1em}
  

  \renewcommand{\refname}{}% For 'article' class
  \renewcommand{\bibname}{}% For 'book' or 'report' class
  
  \small 
  \begin{spacing}{0.9}

  \raggedright 
    

    \let\oldthebibliography\thebibliography
    \renewcommand{\thebibliography}[1]{%
      \oldthebibliography{##1}% 
      \setlength{\itemsep}{2pt}%
      \setlength{\parskip}{0pt}
    }%
    \oldbibliography{#1}%
    
  \end{spacing}%

  \clearpage
}

