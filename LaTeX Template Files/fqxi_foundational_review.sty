%Formatting the Table of Contents (TOC)
\AtBeginDocument{%
    % Rename contents to TOC
    \renewcommand{\contentsname}{Table of Contents}

    % Center the TOC title
    \renewcommand{\cfttoctitlefont}{\hfill\Large\bfseries}
    \renewcommand{\cftaftertoctitle}{\hfill}

    % Entry font styling, each defined only once with hypersetup included
    \renewcommand{\cftsecfont}{\hypersetup{linkcolor=toccolor}\bfseries}
    \renewcommand{\cftsubsecfont}{\hypersetup{linkcolor=toccolor}\itshape}
    \renewcommand{\cftsubsubsecfont}{\hypersetup{linkcolor=toccolor}\small}
}


%set up package that will allow user to manually choose between an author-year or sequential-numbered 

\newbool{fqxi@numeric}
\booltrue{fqxi@numeric} % Default to numeric

\DeclareOption{publication}{
    \geometry{
        letterpaper,
        top=0.85in,
        bottom=0.85in,
        left=0.75in,
        right=0.75in,
        columnsep=0.25in
    }
}

\DeclareOption{manuscript}{
    \geometry{
        letterpaper,
        margin=1.25in,
        footskip=0.5in
    }
}

\DeclareOption{author-year}{\boolfalse{fqxi@numeric}}
\DeclareOption{sequential-numbered}{\booltrue{fqxi@numeric}}


\ExecuteOptions{manuscript,sequential-numbered}
\ProcessOptions\relax


\ifbool{fqxi@numeric}{
    % Settings for Numbered Style
    \RequirePackage[numbers,square,comma,sort&compress]{natbib}
    \newcommand{\setfqxibib}{
        \bibliographystyle{fqxi_numbered}
    }
}{
    % Settings for Author-Year Style
    \RequirePackage[comma,authoryear]{natbib}
    \newcommand{\setfqxibib}{
        \bibliographystyle{fqxi_author_year}
    }
}

